.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx 8rpx;
}

.turn {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: #fffdf8;
  color: #241c14;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.turn.black { border-color: #1b1b1b; }
.turn.white { border-color: #c9bba8; }
.turn.quiet { background: #efe6d4; color: #6d5b48; font-weight: 600; border-color: transparent; }

.disc { width: 26rpx; height: 26rpx; border-radius: 50%; box-sizing: border-box; }
.turn.black .disc { background: #1b1b1b; }
.turn.white .disc { background: #f7f7f7; border: 2rpx solid #8a7764; }

.sound {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf8;
  color: #8a7764;
  font-size: 26rpx;
  font-weight: 600;
}

.sound.on { background: #241c14; color: #f6f1e7; }

.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.frame {
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #7a4e2c, #4e3018);
  box-shadow: 0 10rpx 28rpx rgba(70, 36, 12, 0.16);
}

.board { display: block; border-radius: 12rpx; }

.sheet {
  width: 100%;
  margin-top: 12rpx;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}

.kicker { color: #b64032; font-size: 22rpx; letter-spacing: 0.12em; }
.heading { font-size: 34rpx; font-weight: 650; line-height: 1.3; margin: 4rpx 0 8rpx; }
.copy, .status-line, .note { line-height: 1.65; margin-bottom: 8rpx; font-size: 26rpx; }
.status-line.good { color: #2f6f4e; }
.status-line.bad { color: #b64032; }
.note { color: #6d5b48; }

.stats { display: flex; gap: 12rpx; margin-bottom: 8rpx; }
.stat {
  flex: 1;
  background: rgba(255, 253, 248, 0.9);
  border-radius: 16rpx;
  padding: 10rpx 14rpx;
}
.label { display: block; color: #8a7764; font-size: 20rpx; }

.dock {
  padding: 8rpx 20rpx 10rpx;
  background: #fffdf8;
  border-top: 1px solid rgba(48, 32, 18, 0.06);
}

.row { display: flex; gap: 12rpx; margin-bottom: 10rpx; }
.row:last-child { margin-bottom: 0; }

.btn, .num, .choice, .puzzle {
  box-sizing: border-box;
  background: #f6f1e7;
  color: #241c14;
  border-radius: 16rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.btn { flex: 1; }
.btn.primary { background: #241c14; color: #f6f1e7; }
.btn.quiet { background: #f3eadc; color: #4a3b2c; }
.btn.on { background: #241c14; color: #f6f1e7; }

.nums { gap: 8rpx; }
.num { flex: 1; min-height: 72rpx; padding: 0; font-weight: 650; }
.num.picked { background: #241c14; color: #f6f1e7; }
.num.right { background: #e7f3ec; color: #2f6f4e; }

.choice, .puzzle {
  justify-content: space-between;
  width: 100%;
  margin-bottom: 10rpx;
  padding: 16rpx 20rpx;
  text-align: left;
}
.choice.right, .puzzle.solved { color: #2f6f4e; background: #e7f3ec; }
.choice.wrong { color: #b64032; background: #f8e8e4; }
.puzzle.current { box-shadow: inset 0 0 0 2rpx #241c14; }
.level { color: #8a7764; margin-left: 16rpx; font-size: 22rpx; }

.tabbar {
  display: flex;
  background: #fffdf8;
  border-top: 1px solid rgba(48, 32, 18, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #8a7764;
  font-size: 22rpx;
  background: transparent;
}

.tab.on { color: #b64032; font-weight: 650; }

.mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid currentColor;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
}

.tab.on .mark { background: #b64032; color: #fffdf8; border-color: #b64032; }
